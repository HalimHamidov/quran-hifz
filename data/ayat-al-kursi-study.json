  "segments": [
    {
      "start": 0,
      "end": 7,
      "title": "Единственность и совершенная жизнь",
      "translation": "Аллах — нет божества, кроме Него, Живого, Вседержителя."
    },
    {
      "start": 7,
      "end": 12,
      "title": "Ни дремоты, ни сна",
      "translation": "Не овладевают Им ни дремота, ни сон."
    },
    {
      "start": 12,
      "end": 19,
      "title": "Всё принадлежит Ему",
      "translation": "Ему принадлежит всё, что на небесах, и всё, что на земле."
    },
    {
      "start": 19,
      "end": 26,
      "title": "Заступничество только с разрешения",
      "translation": "Кто тот, кто заступится перед Ним иначе как с Его разрешения?"
    },
    {
      "start": 26,
      "end": 32,
      "title": "Его знание охватывает всё",
      "translation": "Он знает то, что перед ними, и то, что позади них."
    },
    {
      "start": 32,
      "end": 40,
      "title": "Знание творений ограничено",
      "translation": "И они не охватывают ничего из Его знания, кроме того, что Он пожелает."
    },
    {
      "start": 40,
      "end": 44,
      "title": "Величие Курси",
      "translation": "Его Курси объемлет небеса и землю."
    },
    {
      "start": 44,
      "end": 47,
      "title": "Сохранение не тяготит Его",
      "translation": "И не тяготит Его сохранение их обоих."
    },
    {
      "start": 47,
      "end": 50,
      "title": "Всевышний, Великий",
      "translation": "И Он — Всевышний, Великий."
    }
  ],
